# 不提交 Python 运行环境。
#
# 这个目录 264 MB、8665 个文件，而且全是二进制。放进 git 之后，每次改代码都会
# 产生巨大的 diff，别人 clone 也要等好几分钟。
#
# 完整能跑的那一份（含 .venv 和 exe）是打包成 zip 放在 GitHub Releases 里的，
# 想直接用的去那里下载；想自己搭环境的看 requirements.txt。
.venv/
venv/

# 运行日志。每跑一次就变，内容也没什么共享价值。
# 保留目录本身（git 不追踪空目录，所以放了个 .gitkeep 占位）。
logs/*
!logs/.gitkeep

# 面板窗口的位置和大小，每台机器都不一样。
config/gui_window.json

# 面板的访问口令。手机端带着 ?t=<这串> 就能打开面板，传上去等于把钥匙挂网上。
# 现在这个目录里没有这个文件，但只要在本机启动过一次 GUI 就会生成。
# 每次启动都会重新生成，删掉不影响使用。
config/panel_token.txt

# Python 缓存和打包中间产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.spec

# 排查故障时的临时存帧目录
shots/
shots_hp_bogus/
hp_bogus/

# 编辑器
.vscode/
.idea/
Thumbs.db
desktop.ini
