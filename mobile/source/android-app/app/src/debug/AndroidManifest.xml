<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".DebugBattleReceiver"
            android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.kards.mobilert.debug.START_BATTLE" />
                <action android:name="com.kards.mobilert.debug.STOP_BATTLE" />
                <action android:name="com.kards.mobilert.debug.STATUS_BATTLE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".DebugMulliganReceiver"
            android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.kards.mobilert.debug.START_MULLIGAN" />
                <action android:name="com.kards.mobilert.debug.STOP_MULLIGAN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
